# Copy to .env and fill in. On the VPS docker-compose reads these values.

# Public address of the site, used in links and SEO (no trailing slash)
SITE_URL="https://sneakora.uz"
# Domain for automatic HTTPS (Caddy)
DOMAIN="sneakora.uz"

# PostgreSQL password (letters and digits only). docker-compose builds DATABASE_URL from it.
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD="change-me"

# Admin panel (/admin): shared password and a random 32+ character secret for sessions.
# Generate the secret with: openssl rand -base64 32
ADMIN_PASSWORD="change-me"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: Telegram bot that posts every new order to your chat.
# Leave empty to keep it off. See README → «Telegram-бот».
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
